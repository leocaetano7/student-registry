@using Microsoft.AspNetCore.Builder
@using Microsoft.AspNetCore.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Options
@inject IOptions<RequestLocalizationOptions> LocOptions

@{
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();

    var supportedCulturesList = LocOptions.Value?.SupportedUICultures ?? new List<System.Globalization.CultureInfo>();
    var cultureItems = supportedCulturesList
        .Select(c => new SelectListItem { Value = c.Name, Text = c.DisplayName })
        .ToList();

    var returnUrl = string.IsNullOrEmpty(Context.Request.Path) ? "~/" : $"~{Context.Request.Path}{Context.Request.QueryString}";

    var currentCultureName = requestCulture?.RequestCulture.UICulture.Name ?? "pt-BR";
}

<!DOCTYPE html>
<html lang="@currentCultureName">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - @Localizer["SiteTitle"]</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/testeleo.styles.css" asp-append-version="true"/>
</head>
<body>
<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm mb-3">
        <div class="container">
            <a class="navbar-brand" asp-area="" asp-page="/Index">🚀 @Localizer["SiteTitle"]</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                    aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-page="/Index">@Localizer["NavHome"]</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-page="/Students/Index">@Localizer["NavStudents"]</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-page="/Premiums/Index">@Localizer["NavPremiums"]</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-page="/Privacy">@Localizer["NavPrivacy"]</a>
                    </li>
                </ul>

                <!-- Seletor de Idiomas -->
                <div class="me-3" style="max-width: 190px; min-width: 160px;">
                    <form asp-controller="Culture" asp-action="SetLanguage" asp-route-returnUrl="@returnUrl" method="post">
                        <label class="visually-hidden" for="cultureSelect">@Localizer["SelectLanguageLabel"]</label>
                        <select id="cultureSelect" name="culture"
                                onchange="this.form.submit();"
                                asp-for="@requestCulture!.RequestCulture.UICulture.Name"
                                asp-items="cultureItems"
                                class="form-select form-select-sm language-cyber-select">
                        </select>
                    </form>
                </div>

                @* <partial name="_LoginPartial"/> *@
            </div>
        </div>
    </nav>
</header>
<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="footer">
    <div class="container">
        &copy; 2026 - @Localizer["FooterText"] - <a asp-area="" asp-page="/Privacy">@Localizer["NavPrivacy"]</a>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", false)
</body>
</html>
