@page
@model RegistroDeEstudantes.Pages_Students.DeleteModel

@{
    ViewData["Title"] = Localizer["StudentDeleteTitle"];
}

<h1>@ViewData["Title"]</h1>

<h3>@Localizer["ConfirmDelete"]</h3>
<div>
    <h4>@Localizer["StudentSectionTitle"]</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Student.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Student.Name)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Student.Email)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Student.Email)
        </dd>
    </dl>

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        
        <input type="hidden" asp-for="Student.Id"/>
        <input type="submit" value="@Localizer["ActionDelete"]" class="btn btn-danger"/> |
        <a asp-page="./Index">@Localizer["BackToList"]</a>
    </form>
</div>
