@page
@model RegistroDeEstudantes.Pages_Students.DetailsModel

@{
    ViewData["Title"] = Localizer["StudentDetailsTitle"];
}

<h1>@ViewData["Title"]</h1>

<div>
    <h4>@Localizer["StudentSectionTitle"]</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Student.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Student.Name)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Student.Email)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Student.Email)
        </dd>
    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.Student.Id">@Localizer["ActionEdit"]</a> |
    <a asp-page="./Index">@Localizer["BackToList"]</a>
</div>
