@page
@model testeleo.Pages_Students.IndexModel

@{
    ViewData["Title"] = Localizer["StudentsPageTitle"];
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-page="Create">@Localizer["ActionCreateNew"]</a>
</p>
<table class="table">
    <thead>
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Student[0].Name)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Student[0].Email)
        </th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.Student) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">@Localizer["ActionEdit"]</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">@Localizer["ActionDetails"]</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">@Localizer["ActionDelete"]</a>
            </td>
        </tr>
    }
    </tbody>
</table>
