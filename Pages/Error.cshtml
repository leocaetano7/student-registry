@page
@model ErrorModel
@{
    ViewData["Title"] = Localizer["ErrorTitle"];
}

<h1 class="text-danger">@Localizer["ErrorTitle"].</h1>
<h2 class="text-danger">@Localizer["ErrorHeading"]</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>@Localizer["ErrorRequestId"]</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>@Localizer["ErrorDevModeTitle"]</h3>
<p>
    @Localizer["ErrorDevModeText1"]
</p>
<p>
    <strong>@Localizer["ErrorDevModeText2"]</strong>
</p>
