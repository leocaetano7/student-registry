@page
@model RegistroDeEstudantes.Pages_Premiums.DeleteModel

@{
    ViewData["Title"] = Localizer["PremiumDeleteTitle"];
}

<h1>@ViewData["Title"]</h1>

<h3>@Localizer["ConfirmDelete"]</h3>
<div>
    <h4>@Localizer["PremiumSectionTitle"]</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Premium.Title)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Premium.Title)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Premium.StartDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Premium.StartDate)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Premium.EndDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Premium.EndDate)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Premium.Student)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Premium.Student!.Email)
        </dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Premium.Id" />
        <input type="submit" value="@Localizer["ActionDelete"]" class="btn btn-danger" /> |
        <a asp-page="./Index">@Localizer["BackToList"]</a>
    </form>
</div>
