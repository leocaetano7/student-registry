@page
@model RegistroDeEstudantes.Pages_Premiums.IndexModel

@{
    ViewData["Title"] = Localizer["PremiumsPageTitle"];
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-page="Create">@Localizer["ActionCreateNew"]</a>
</p>
<table class="table">
    <thead>
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Premiums[0].Title)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Premiums[0].StartDate)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Premiums[0].EndDate)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Premiums[0].Student)
        </th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.Premiums) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Title)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.StartDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EndDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Student!.Email)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">@Localizer["ActionEdit"]</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">@Localizer["ActionDetails"]</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">@Localizer["ActionDelete"]</a>
            </td>
        </tr>
    }
    </tbody>
</table>